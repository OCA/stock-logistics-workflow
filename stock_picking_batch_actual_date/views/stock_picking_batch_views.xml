<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_batch_filter" model="ir.ui.view">
        <field name="name">stock.picking.batch.filter</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_filter" />
        <field name="arch" type="xml">
            <filter name="done" position="after">
                <separator />
                <filter
                    name="actual_date"
                    date="actual_date"
                    default_period="this_month"
                />
            </filter>
            <filter name="state" position="after">
                <filter
                    string="Actual Date"
                    name="by_actual_date"
                    domain="[]"
                    context="{'group_by': 'actual_date'}"
                />
            </filter>
        </field>
    </record>
    <record id="stock_picking_batch_form" model="ir.ui.view">
        <field name="name">stock.picking.batch.form</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scheduled_date']" position="before">
                <field name="is_editable_actual_date" invisible="1" />
                <field
                    name="actual_date"
                    attrs="{'readonly': [('is_editable_actual_date', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
    <record id="stock_picking_batch_tree" model="ir.ui.view">
        <field name="name">stock.picking.batch.tree</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scheduled_date']" position="before">
                <field name="actual_date" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
