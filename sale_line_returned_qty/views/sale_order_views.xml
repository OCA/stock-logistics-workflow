<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form - sale_line_returned_qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page/field[@name='order_line']/form/group/group/div[@name='delivered_qty']"
                position="after"
            >
                <label
                    for="qty_returned"
                    string="Returned"
                    invisible="parent.state not in ['sale', 'done']"
                />
                <div
                    name="returned_qty"
                    invisible="parent.state not in ['sale', 'done']"
                >
                    <field name="qty_returned" readonly="True" />
                </div>
            </xpath>
            <!-- The list now wraps its fields in `column` elements on 20.0 -->
            <xpath
                expr="//field[@name='order_line']/list/column[field[@name='qty_delivered']]"
                position="after"
            >
                <column column_invisible="parent.state not in ['sale', 'done']">
                    <field
                        name="qty_returned"
                        readonly="True"
                        string="Returned"
                        optional="show"
                    />
                </column>
            </xpath>
        </field>
    </record>
</odoo>
