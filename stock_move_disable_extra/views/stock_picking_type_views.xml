<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_picking_type_form_disable_extra" model="ir.ui.view">
        <field name="name">stock.picking.type.form.disable.extra</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_entire_packs']" position="after">
                <field name="disable_extra_moves" />
            </xpath>
        </field>
    </record>

</odoo>
