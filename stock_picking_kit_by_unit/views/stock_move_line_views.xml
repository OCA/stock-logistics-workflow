<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_line_kit_operations_tree" model="ir.ui.view">
        <field name="name">stock.move.line.kit.operations.list</field>
        <field name="model">stock.move.line</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list
                editable="bottom"
                decoration-muted="state == 'done' and is_locked == True"
                decoration-bf="kit_first_in_box"
                multi_edit="1"
                default_order="kit_sequence, id"
            >
                <header>
                    <button
                        class="btn-primary"
                        name="action_pack_all_kits"
                        type="object"
                        string="Pack All Kits"
                        groups="stock.group_tracking_lot"
                    />
                </header>
                <field name="kit_sequence" optional="hide" />
                <field name="kit_first_in_box" column_invisible="True" />
                <field name="kit_product_id" readonly="True" />
                <field name="product_id" readonly="True" />
                <field name="company_id" column_invisible="True" />
                <field name="move_id" column_invisible="True" />
                <field name="picking_id" column_invisible="True" />
                <field name="picking_code" column_invisible="True" />
                <field name="picking_location_id" column_invisible="True" />
                <field name="picking_location_dest_id" column_invisible="True" />
                <field name="location_id" column_invisible="True" />
                <field name="location_dest_id" column_invisible="True" />
                <field name="package_id" column_invisible="True" />
                <field
                    name="lot_id"
                    groups="stock.group_production_lot"
                    column_invisible="context.get('picking_code') != 'incoming' or context.get('show_lots_text')"
                    invisible="not lots_visible"
                    readonly="state in ('done', 'cancel') and is_locked"
                    context="{'default_product_id': product_id, 'active_picking_id': picking_id}"
                    optional="show"
                />
                <field
                    name="lot_name"
                    string="Lot/Serial Number"
                    groups="stock.group_production_lot"
                    column_invisible="context.get('picking_code') != 'incoming' or not context.get('show_lots_text')"
                    invisible="not lots_visible"
                    readonly="state in ('done', 'cancel') and is_locked"
                    context="{'default_product_id': product_id}"
                />
                <field
                    name="result_package_id"
                    readonly="state in ('done', 'cancel') and is_locked"
                    widget="package_m2o"
                    context="{'show_dest_package': 1}"
                    groups="stock.group_tracking_lot"
                />
                <field name="lots_visible" column_invisible="True" />
                <field name="state" column_invisible="True" />
                <field name="is_locked" column_invisible="True" />
                <field
                    name="quantity"
                    readonly="state in ('done', 'cancel') and is_locked"
                    force_save="1"
                />
                <field
                    name="product_uom_id"
                    force_save="1"
                    readonly="state != 'draft' and id"
                    groups="uom.group_uom"
                    widget="many2one_uom"
                />
            </list>
        </field>
    </record>
</odoo>
