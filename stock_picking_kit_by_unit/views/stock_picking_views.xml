<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <button name="action_detailed_operations" position="after">
                <button
                    name="action_kit_operations"
                    class="oe_stat_button"
                    icon="fa-cube"
                    type="object"
                    help="Kit component operations sorted per unit"
                    invisible="not has_kit_lines"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Process Kits</span>
                    </div>
                </button>
            </button>
        </field>
    </record>
</odoo>
