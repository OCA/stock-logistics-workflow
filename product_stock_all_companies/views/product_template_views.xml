<odoo>
    <record id="view_template_property_form" model="ir.ui.view">
        <field name="name">product.template.form (product_stock_all_companies)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='inventory']//field[@name='description_picking']/.."
                position="after"
            >
                <group
                    string="Stock by companies"
                    invisible="not stock_by_company_ids or product_variant_count &gt; 1"
                >
                    <field name="stock_by_company_ids" nolabel="1" colspan="2">
                        <list>
                            <field name="company_id" />
                            <field name="quantity_available" />
                            <field name="uom_id" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
