+<div class="document" id="stock-picking-group-by-partner-and-carrier">
+<h1 class="title">Stock Picking: group by partner and carrier</h1>
+
+<!-- !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
+!! This file is generated by oca-gen-addon-readme !!
+!! changes will be overwritten.                   !!
