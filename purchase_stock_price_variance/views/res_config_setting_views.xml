<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='warning_info']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="enable_price_variance_error" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enable_price_variance_error" />
                        <div class="text-muted">
                            Enable the feature that triggers an error when receiving a product if
                            the price difference exceeds the threshold.
                        </div>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="price_variance_threshold_percent" />
                        <div class="text-muted">
                            Maximum variance (in percent) allowable between the product's standard
                            price and purchase receipt unit price.
                            Keeping it at zero means that this threshold will not be checked.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="price_variance_threshold_percent"
                                    widget="percentage"
                                    class="oe_inline"
                                    style="vertical-align:baseline"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="price_variance_threshold_amount" />
                        <div class="text-muted">
                            Maximum allowable variance (in monetary amount, based on company
                            currency) between the product's standard price and the purchase receipt
                            unit price.
                            Keeping it at zero means that this threshold will not be checked.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="price_variance_threshold_amount"
                                    class="oe_inline"
                                    style="vertical-align:baseline"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
