<odoo>
    <record model="ir.ui.view" id="stock_picking_form_view">
        <field
            name="name"
        >stock.picking.form (in stock_picking_operation_loss_quantity)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_loss_picking" invisible="1" />
                <field
                    name="loss_declaration_count"
                    attrs="{'invisible': [('is_loss_picking', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
