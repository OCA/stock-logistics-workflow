<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">product_expiry_simple.stock.move.line.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field
                    name="expiry_date"
                    readonly="package_level_id and parent.picking_type_entire_packs"
                    column_invisible="parent.has_tracking == 'none' or not parent.show_lots_text"
                    groups="stock.group_production_lot"
                />
            </field>
        </field>
    </record>
    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="name">product_expiry_simple.stock.move.line.tree</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field
                    name="expiry_date"
                    column_invisible="not context.get('show_lots_text')"
                    invisible="not lots_visible"
                    groups="stock.group_production_lot"
                />
            </field>
        </field>
    </record>
</odoo>
