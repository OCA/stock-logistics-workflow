<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_line_tree_inherit_picking_partner" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.picking.partner</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="picking_partner_id" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_move_line_search_inherit_picking_partner" model="ir.ui.view">
        <field name="name">stock.move.line.search.inherit.picking.partner</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="picking_partner_id" />
                <filter
                    string="With Picking Partner"
                    name="with_picking_partner"
                    domain="[('picking_partner_id', '!=', False)]"
                />
            </xpath>

            <xpath expr="//group[@name='groupby']" position="inside">
                <filter
                    string="Picking Partner"
                    name="groupby_picking_partner"
                    domain="[]"
                    context="{'group_by': 'picking_partner_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
