<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field
            name="name"
        >stock.picking.form - stock_picking_immediate_transfer_warning</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='button_validate'][hasclass('oe_highlight')]"
                position="attributes"
            >
                <attribute name="context">
                    {'show_immediate_warning': True}
                </attribute>
            </xpath>
            <xpath
                expr="//button[@name='button_validate'][hasclass('o_btn_validate')]"
                position="attributes"
            >
                <attribute name="context">
                    {'show_immediate_warning': True}
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- Override the list view server action to pass context -->
    <record id="stock.action_validate_picking" model="ir.actions.server">
        <field name="code">
            if records:
                res = records.with_context(show_immediate_warning=True).button_validate()
                if isinstance(res, dict):
                    action = res
        </field>
    </record>
</odoo>
