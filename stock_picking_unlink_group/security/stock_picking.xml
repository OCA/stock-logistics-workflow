        <value eval="{'perm_unlink': False}" />
    </function>
    <function model="ir.model.access" name="write">
        <value eval="[ref('stock.access_stock_picking_manager')]" />
        <value eval="{'perm_unlink': False}" />
    </function>
    <record model="res.groups" id="group_stock_picking_unlink">
