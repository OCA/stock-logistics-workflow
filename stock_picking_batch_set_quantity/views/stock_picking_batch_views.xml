<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_picking_move_tree_inherited">
        <field name="model">stock.move</field>
        <field
            name="inherit_id"
            ref="stock_picking_batch.view_picking_move_tree_inherited"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="decoration-success">picked</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <button
                    name="action_set_quantity"
                    invisible="state in ['done', 'cancel'] or picked"
                    title="Set picked"
                    type="object"
                    groups="stock.group_stock_user"
                    icon="oi-arrow-right"
                />
            </xpath>
        </field>
    </record>
</odoo>
