<odoo>
    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field
            name="inherit_id"
            ref="stock_picking_auto_create_package.view_picking_type_form"
        />
        <field name="arch" type="xml">
            <field name="automatic_package_creation_mode" position="after">
                <field
                    name="auto_pack_requires_packaging"
                    invisible="not automatic_package_creation_mode"
                />
            </field>
        </field>
    </record>
</odoo>
