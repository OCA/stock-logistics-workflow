<odoo>
    <record model="ir.ui.view" id="make_picking_batch_abstract_form_view">
        <field name="model">make.picking.batch.abstract</field>
        <field
            name="inherit_id"
            ref="stock_picking_batch_creation.make_picking_batch_abstract_form_view"
        />
        <field name="arch" type="xml">
            <group name="criteria" position="inside">
                <field name="group_reservation_rate" />
                <field
                    name="group_reservation_rate_min"
                    invisible="group_reservation_rate == False"
                />
                <field
                    name="group_reservation_rate_max"
                    invisible="group_reservation_rate == False"
                />
                <field name="additional_group_reservation_rate" />
                <field
                    name="additional_group_reservation_rate_min"
                    invisible="additional_group_reservation_rate == False"
                />
                <field
                    name="additional_group_reservation_rate_max"
                    invisible="additional_group_reservation_rate == False"
                />
            </group>
        </field>
    </record>
</odoo>
