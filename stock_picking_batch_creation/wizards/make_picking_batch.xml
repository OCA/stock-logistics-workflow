<odoo>
    <record model="ir.ui.view" id="make_picking_batch_form_view">
        <field
            name="name"
        >make.picking.batch.form (in stock_picking_batch_creation)</field>
        <field name="model">make.picking.batch</field>
        <field
            name="inherit_id"
            ref="stock_picking_batch_creation.make_picking_batch_abstract_form_view"
        />
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="string">Make Picking Batch</attribute>
            </form>
            <footer position="inside">
                <button
                    name="create_batch"
                    string="Create batch picking"
                    class="btn-primary"
                    type="object"
                />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </field>
    </record>
    <record model="ir.actions.act_window" id="make_picking_batch_act_window">
        <field name="name">Make Picking Batch</field>
        <field name="res_model">make.picking.batch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="make_picking_batch_form_view" />
    </record>

    <record id="action_launch_batch_creation" model="ir.actions.server">
        <field name="name">Launch Batch Creation</field>
        <field
            name="model_id"
            ref="stock_picking_batch_creation.model_make_picking_batch"
        />
        <field
            name="binding_model_id"
            ref="stock_picking_batch_creation.model_make_picking_batch"
        />
        <field name="state">code</field>
        <field name="code">
            action = model.action_launch_picking_batch()
        </field>
    </record>

    <menuitem
        action="action_launch_batch_creation"
        id="make_picking_batch"
        parent="stock_picking_batch.menu_stock_jobs"
        sequence="10"
    />
</odoo>
