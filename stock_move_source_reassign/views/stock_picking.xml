<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']"
                position="after"
            >
                <field name="can_be_reassigned" invisible="1" />
                <button
                    name="action_source_reassign"
                    type="object"
                    icon="fa-random"
                    class="btn btn-link oe_inline"
                    title="Reassign"
                    attrs="{'invisible': [('can_be_reassigned', '=', False)]}"
                />
            </xpath>
            <field name="company_id" position="after">
                <field name="can_be_reassigned" invisible="1" />
            </field>
            <button name="action_cancel" position="after">
                <button
                    name="action_source_reassign"
                    attrs="{'invisible': [('can_be_reassigned', '=', False)]}"
                    string="Reassign"
                    icon="fa-random"
                    groups="stock.group_stock_manager"
                    type="object"
                    data-hotkey="r"
                />
            </button>
        </field>
    </record>

</odoo>
