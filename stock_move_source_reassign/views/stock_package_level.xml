<odoo>
    <record id="package_level_tree_view_picking" model="ir.ui.view">
        <field name="name">Package Level</field>
        <field name="model">stock.package_level</field>
        <field name="inherit_id" ref="stock.package_level_tree_view_picking" />
        <field name="arch" type="xml">
            <field name="package_id" position="after">
                <field name="can_be_reassigned" invisible="1" />
                <button
                    name="action_source_reassign"
                    type="object"
                    icon="fa-random"
                    class="btn btn-link oe_inline"
                    title="Reassign"
                    attrs="{'invisible': [('can_be_reassigned', '=', False)]}"
                />
            </field>
        </field>
    </record>
</odoo>
