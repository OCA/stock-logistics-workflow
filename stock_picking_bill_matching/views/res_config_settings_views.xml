<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_stock_bill_matching" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.stock.bill.matching</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block
                    title="Bill Matching"
                    name="stock_bill_matching_setting_container"
                >
                    <setting
                        id="auto_create_picking_on_match"
                        string="Auto Create Receipt On Match"
                        help="Automatically create a receipt picking when clicking 'Match Pickings' on a Bill if no open picking/PO exists."
                    >
                        <field name="auto_create_picking_on_match" />
                    </setting>
                    <setting
                        id="auto_validate_matched_picking"
                        string="Auto Validate Matched Picking"
                        help="Automatically validate generated incoming receipts when fully matched from a bill."
                    >
                        <field name="auto_validate_matched_picking" />
                    </setting>
                    <setting
                        id="auto_match_referenced_lines"
                        string="Auto Match Referenced Lines"
                        help="Automatically match the bill lines whose reference (in Brazil the NFe xPed/nItemPed pair, i.e. the purchase order and its line number, or the reference generated by the document import) is shared by a receipt line. Unreferenced lines stay manual."
                    >
                        <field name="auto_match_referenced_lines" />
                    </setting>
                    <setting
                        id="auto_match_referenced_on_post"
                        string="Auto Match On Bill Posting"
                        help="Also run the automatic matching when a bill is posted, so imported bills are reconciled without any click."
                    >
                        <field name="auto_match_referenced_on_post" />
                    </setting>
                    <setting
                        id="auto_create_picking_on_post"
                        string="Auto Create Receipt On Posting"
                        help="Small shop flow: when posting a bill whose lines have nothing to match against (no purchase order, no receipt for the vendor), create the receipt from those lines. A purchase order or an existing receipt candidate stops the automatic creation."
                    >
                        <field name="auto_create_picking_on_post" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
