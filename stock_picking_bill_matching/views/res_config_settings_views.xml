<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_stock_bill_matching" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.stock.bill.matching</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="BillMatching"
                    string="Bill Matching"
                    data-key="bill-matching"
                    groups="stock.group_stock_manager"
                >
                <h2>Bill Matching</h2>
                <div
                        class="row mt16 o_settings_container"
                        id="stock_bill_matching_settings"
                    >
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="auto_create_picking_on_match" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="auto_create_picking_on_match" />
                            <div class="text-muted">
                                Automatically create a receipt picking when clicking 'Match Pickings' on a Bill if no open picking/PO exists.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="auto_validate_matched_picking" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="auto_validate_matched_picking" />
                            <div class="text-muted">
                                Automatically validate generated incoming receipts when fully matched from a bill.
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
