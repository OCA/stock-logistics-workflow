<odoo>
    <record id="view_template_property_form" model="ir.ui.view">
        <field name="name">product.template.auto.create.lot</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_stock" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='traceability']" position="inside">
                <field
                    name="auto_create_lot"
                    invisible="store_by not in ['lot', 'serial']"
                />
            </xpath>
        </field>
    </record>
</odoo>
