<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="reception_report" position="after">
                <setting
                    id="reassign_stock_move_after_free_reservation"
                    help="Try to automatically reassign stock moves after a free reservation due to an inventory adjustment."
                >
                    <field name="reassign_stock_move_after_free_reservation" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
