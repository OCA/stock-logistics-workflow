<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="reception_report" position="after">
                <setting
                    class="col-xs-12 col-md-6 o_setting_box"
                    id="reassign_stock_move_after_free_reservation"
                >
                        <field name="reassign_stock_move_after_free_reservation" />
                        <div class="text-muted">
                Try to automatically reassign stock moves after a free reservation
                due to an inventory adjustment.
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
