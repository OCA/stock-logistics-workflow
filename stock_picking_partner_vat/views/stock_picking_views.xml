<odoo>
    <record id="view_stock_picking_form_partner_vat" model="ir.ui.view">
        <field name="name">stock.picking (partner_vat)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_vat" invisible="not partner_vat" />
            </xpath>
        </field>
    </record>
</odoo>
