<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.stock.landed.costs.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='additional_cost_setting']" position="after">
                <setting
                    id="landed_cost_apply_rule"
                    help="Applies rules based on the cost products selected in the product."
                >
                    <field name="landed_costs_apply_rule" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
