<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_only_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit.stock.landed.costs.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='operations']" position="after">
                <group name="landed_costs_product" string="Landed Costs">

                    <label for="landed_cost_specific" invisible="not purchase_ok" />
                    <div invisible="not purchase_ok">
                        <field name="landed_cost_specific" class="mb-0" />
                    </div>

                    <label
                        for="product_tmpl_landed_cost_ids"
                        string="Product Landed Costs"
                        invisible="not landed_cost_specific"
                    />
                    <div invisible="not landed_cost_specific">
                        <field
                            name="product_tmpl_landed_cost_ids"
                            class="mb-0"
                            nolabel="1"
                            domain="[('landed_cost_ok', '=', True)]"
                            widget="many2many_checkboxes"
                        />
                    </div>

                </group>
            </xpath>
        </field>
    </record>

</odoo>
