<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_location_validate_inventory" model="ir.actions.server">
        <field name="name">Validate Inventory</field>
        <field name="model_id" ref="stock.model_stock_location" />
        <field name="state">code</field>
        <field name="code">records.validate_inventory()</field>
        <field name="binding_model_id" ref="stock.model_stock_location" />
        <field name="binding_type">action</field>
        <field
            name="groups_id"
            eval="[(4, ref('stock_location_validate_inventory.group_stock_location_can_validate_inventory'))]"
        />
    </record>

</odoo>
