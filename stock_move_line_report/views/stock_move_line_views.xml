<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_to_print_label" invisible="1" />
                <button
                    name="action_print_operation_label"
                    type="object"
                    class="btn-outline-secondary"
                    icon="fa-print"
                    aria-label="Print label"
                    title="Print label"
                    attrs="{'invisible': ['|', ('allowed_to_print_label', '=', False), ('qty_done', '=', 0)]}"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_detailed" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_to_print_label" invisible="1" />
                <button
                    name="action_print_operation_label"
                    type="object"
                    class="btn-outline-secondary"
                    icon="fa-print"
                    aria-label="Print label"
                    title="Print label"
                    attrs="{'invisible': ['|', ('allowed_to_print_label', '=', False), ('qty_done', '=', 0)]}"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_picking_batch.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_to_print_label" invisible="1" />
                <button
                    name="action_print_operation_label"
                    type="object"
                    class="btn-outline-secondary"
                    icon="fa-print"
                    aria-label="Print label"
                    title="Print label"
                    attrs="{'invisible': ['|', ('allowed_to_print_label', '=', False), ('qty_done', '=', 0)]}"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
