<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.batch.picking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <field name="module_stock_picking_batch" position="after">
                <setting
                    id="use_oca_batch_validation"
                    string=">Apply OCA batch validation"
                    help="Adds extra fields and functionalities to the batch picking form"
                >
                    <field name="use_oca_batch_validation" />
                </setting>
            </field>
        </field>
    </record>
</odoo>
