<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.batch.picking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <field name="module_stock_picking_batch" position="after">
                <div class="row mt-2" invisible="not module_stock_picking_batch">
                    <field
                        name="use_oca_batch_validation"
                        class="col flex-grow-0 ml16 mr0 pe-2"
                    />
                    <div class="col ps-0">
                        <label for="use_oca_batch_validation" />
                        <div class="text-muted">Apply OCA batch validation</div>
                    </div>
                </div>
            </field>
            <xpath
                expr="//block[@name='operations_setting_container']"
                position="inside"
            >
                <setting
                    id="split_transfers_from_batch_id"
                    help="It allows you to establish new quantities for picking movements using a wizard and create partial deliveries, without the batch being validated"
                    invisible="not module_stock_picking_batch"
                >
                    <field name="split_transfers_from_batch" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
