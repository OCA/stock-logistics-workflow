<odoo>
    <template id="report_shipment_composer_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-set="partner" t-value="o.partner_id" />
                <t t-set="address">
                    <div name="div_outgoing_address">
                        <div
                            name="outgoing_delivery_address"
                            t-if="o.picking_type_id.code == 'outgoing'"
                        >
                            <span><strong>Delivery Address:</strong></span>
                            <div
                                t-field="o.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                            />
                        </div>
                        <div
                            name="outgoing_warehouse_address"
                            t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id"
                        >
                            <span><strong>Warehouse Address:</strong></span>
                            <div
                                t-field="o.picking_type_id.warehouse_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                            />
                        </div>
                    </div>
                </t>
                <t t-set="information_block">
                    <div class="row">
                        <div class="col-7" name="div_incoming_address">
                            <t t-set="show_partner" t-value="False" />
                            <div
                                name="vendor_address"
                                t-if="o.picking_type_id.code=='incoming' and partner"
                            >
                                <span><strong>Vendor Address:</strong></span>
                                <t t-set="show_partner" t-value="True" />
                            </div>
                            <div
                                name="customer_address"
                                t-if="o.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id"
                            >
                                <span><strong>Customer Address:</strong></span>
                                <t t-set="show_partner" t-value="True" />
                            </div>
                            <div t-if="show_partner" name="partner_header">
                                <div
                                    t-field="partner.commercial_partner_id"
                                    t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'
                                />
                            </div>
                        </div>
                    </div>
                </t>
                <div class="page">
                    <h2>
                        <span t-field="o.name" />
                    </h2>
                    <div class="row mt-4 mb-4">
                        <div
                            t-if="o.user_id"
                            class="col-auto col-3 mw-100 mb-2"
                            name="div_user"
                        >
                            <strong>Responsible:</strong>
                            <p t-field="o.user_id" class="m-0" />
                        </div>
                        <div class="col-auto col-3 mw-100 mb-2" name="div_sched_date">
                            <strong>Shipping Date:</strong>
                            <t t-if="o.state == 'done'">
                                <p t-field="o.date_done" class="m-0" />
                            </t>
                            <t t-if="o.state != 'done'">
                                <p t-field="o.scheduled_date" class="m-0" />
                            </t>
                        </div>
                    </div>
                    <table class="table table-sm" name="composer_line_table">
                        <thead>
                            <tr>
                                <th name="th_product"><strong>Product</strong></th>
                                <th name="th_transfer"><strong>Transfer</strong></th>
                                <th name="th_quantity"><strong>Quantity</strong></th>
                                <th name="th_remark"><strong>Remark</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.line_ids" t-as="line">
                                <td>
                                    <span t-field="line.move_id.product_id" />
                                </td>
                                <td>
                                    <span t-field="line.picking_id" />
                                </td>
                                <td>
                                    <span t-field="line.quantity" />
                                    <span t-field="line.uom_id" />
                                </td>
                                <td>
                                    <span t-field="line.remarks" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
         </t>
    </template>
    <template id="report_shipment_composer">
        <t t-foreach="docs" t-as="o">
            <t t-set="lang" t-value="o.partner_id.lang" />
            <t
                t-call="stock_shipment_composer.report_shipment_composer_document"
                t-lang="lang"
            />
        </t>
    </template>
</odoo>
