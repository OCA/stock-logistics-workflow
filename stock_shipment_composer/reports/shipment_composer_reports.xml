<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="report_stock_shipment_composer" model="ir.actions.report">
        <field name="name">Stock Shipment Composer</field>
        <field name="model">stock.shipment.composer</field>
        <field
            name="report_name"
        >stock_shipment_composer.report_shipment_composer</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_file"
        >stock_shipment_composer.report_shipment_composer</field>
        <field name="binding_model_id" ref="model_stock_shipment_composer" />
        <field name="binding_type">report</field>
        <field
            name="print_report_name"
        >'Stock Shipment Composer - %s - %s' % (object.partner_id.name, object.name)</field>
    </record>
</odoo>
