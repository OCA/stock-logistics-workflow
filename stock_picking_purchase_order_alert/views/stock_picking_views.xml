<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_inherit_quantity_check" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.quantity.check</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <field name="has_quantity_alert" invisible="1" />
                <field
                    name="quantity_alert_message"
                    attrs="{'invisible': [('has_quantity_alert', '=', False), ('state', 'in', ('done', 'cancel'))]}"
                    widget="html"
                    nolabel="1"
                />
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_alert" model="ir.ui.view">
        <field name="name">stock.picking.internal.search.alert</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <filter name="cancel" position="after">
                <separator />
                <filter
                    name="not_printed"
                    string="Not Printed"
                    domain="[('printed', '=', False)]"
                    help="Not printed Moves"
                />
            </filter>
            <filter name="starred" position="after">
                <filter
                    string="Picking Quantity Alert"
                    name="picking_quantity_alert"
                    domain="[('has_quantity_alert', '=', True)]"
                />
            </filter>
        </field>
    </record>

</odoo>
