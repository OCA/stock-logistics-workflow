<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_stock_picking_alert_wizard" model="ir.ui.view">
        <field name="name">stock.picking.alert.wizard.form</field>
        <field name="model">stock.picking.alert.wizard</field>
        <field name="arch" type="xml">
            <form string="Quantity Alert">
                <div role="alertdialog" class="alert text-center alert-danger">
                    <h3 class="alert-heading"><i
                            class="fa fa-exclamation-triangle"
                        /> Warning</h3>
                    <p
                    >Cannot validate this receipt because the received quantity exceeds
                    the ordered quantity by more than the configured threshold percentage.</p>
                    <p
                        class="mb-0"
                    >Please verify the quantities before proceeding or contact your supervisor if you need assistance.</p>
                </div>
                <footer>
                    <button
                        name="action_confirm"
                        string="Proceed Anyway"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        special="cancel"
                        string="Review Quantities"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
