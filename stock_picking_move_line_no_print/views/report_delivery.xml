<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_delivery_document"
        inherit_id="stock.report_delivery_document"
        priority="99"
    >
        <xpath expr="//tr[@t-foreach='o.move_line_ids']" position="attributes">
            <attribute name="t-if">move_line.display_in_report</attribute>
        </xpath>
        <xpath expr="//tr[@t-foreach='lines']" position="attributes">
            <attribute name='t-if'>move.display_in_report</attribute>
        </xpath>
    </template>
</odoo>
