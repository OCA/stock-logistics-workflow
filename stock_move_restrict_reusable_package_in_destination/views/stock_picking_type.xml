<odoo>
    <record model="ir.ui.view" id="stock_picking_type_form_view">
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <group name="locations" position="after">
                <group
                    name="reusable_package_restriction"
                    string="Reusable Packages Restriction"
                    groups="stock.group_tracking_lot"
                >
                    <field name="restrict_reusable_package_in_destination" />
                    <field name="log_warning_reusable_package_in_destination" />
                </group>
            </group>
        </field>
    </record>
</odoo>
