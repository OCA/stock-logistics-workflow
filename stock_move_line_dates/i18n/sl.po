#. module: stock_move_line_dates
#: model:ir.model.fields,help:stock_move_line_dates.field_stock_move_line__scheduled_date
msgid "Scheduled date until move is done, then date of actual move processing"
msgstr ""
"Načrtovani datum dokler premik ni opravljen, nato datum dejanske obdelave "
"premika"

