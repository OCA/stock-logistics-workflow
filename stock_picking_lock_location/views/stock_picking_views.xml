<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="picking_type_id" position="after">
                <field name="lock_location_id" invisible="1" />
                <field name="lock_location_dest_id" invisible="1" />
            </field>
            <xpath expr="//field[@name='location_dest_id'][2]" position="attributes">
                <attribute
                    name="readonly"
                >state == 'done' or lock_location_dest_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id'][2]" position="attributes">
                <attribute
                    name="readonly"
                >state == 'done' or lock_location_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
