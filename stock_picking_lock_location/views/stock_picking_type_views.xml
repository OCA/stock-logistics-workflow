<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">Operation Types</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <group name="locations" position="inside">
                <field name="company_lock_location_id" invisible="1" />
                <field name="company_lock_location_dest_id" invisible="1" />
                <field
                    name="lock_location_id"
                    invisible="not company_lock_location_id"
                />
                <field
                    name="lock_location_dest_id"
                    invisible="not company_lock_location_dest_id "
                />
            </group>
        </field>
    </record>
</odoo>
