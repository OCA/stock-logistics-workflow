<odoo>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="name">Destination Suggestion</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <button name="button_validate" position="after">
        <field name="suggest_destination_visible" invisible="1" />
        <button
                    name="suggest_destination"
                    class="btn"
                    type="object"
                    string="Suggest Destination"
                    attrs="{'invisible': [('suggest_destination_visible', '=', False)]}"
                />
      </button>
    </field>
  </record>
</odoo>
