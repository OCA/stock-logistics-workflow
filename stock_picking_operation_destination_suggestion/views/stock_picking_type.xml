<odoo>

    <record model="ir.ui.view" id="stock_picking_type_form_view">
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='show_entire_packs']/parent::group"
                position="after"
            >
                <group string="Destination suggestion" name="Destination suggestion">
                    <field name="suggest_destination" />
                    <field
                        name="suggest_destination_partner"
                        attrs="{'invisible': [('suggest_destination', '=', False)]}"
                    />
                    <field
                        name="suggest_destination_additional_domain"
                        widget="domain"
                        options="{'model': 'stock.location', 'in_dialog': True}"
                        attrs="{'invisible': [('suggest_destination', '=', False)]}"
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
