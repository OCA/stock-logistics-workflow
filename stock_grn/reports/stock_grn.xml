<odoo>
    <template id="label_stock_grn">
        <t t-set="curr_date" t-value="datetime.datetime.today()" />
        <t t-foreach="docs" t-as="grn">
          <t
                t-set="total"
                t-value="(grn.qty_box + grn.qty_pallet) if (grn.qty_box or grn.qty_pallet) else 1"
            />
            <t t-foreach="range(1, total + 1, 1)" t-as="number">
^XA
<t t-name="supplier_name">
^CF0,50
^FO010,50^FD<t t-esc="grn.supplier_id.display_name" />^FS
</t>
<t t-name="grn_number">
^CF0,25

^FO250,115^FDNUMBER: <t t-esc="number" /> / <t t-esc="total" /> ^FS
</t>
<t t-name="reference">
^FO250,150^FDREF: <t t-esc="grn.ref" />^FS
</t>
<t t-name="origin">
^FO250,185^FDORIGIN: <t
                        t-esc="','.join([origin for origin in grn.picking_ids.mapped('origin') if origin])"
                    />^FS
</t>
<t t-name="grn_supplier">
^FO250,220^FDSUPPLIER REF: <t t-esc="grn.delivery_note_supplier_number" />^FS
</t>
<t t-name="grn_boxes">
^FO250,255^FDBOXES: <t t-esc="grn.qty_box" />^FS
</t>
<t t-name="grn_pallets">
^FO250,290^FDPALLETS: <t t-esc="grn.qty_pallet" />^FS
</t>
<t t-name="grn_number">
^FO250,325^FDDATE: <t t-esc="curr_date" t-options='{"widget": "date"}' />^FS
</t>
<t t-name="grn_qr">
^BQN,2,6,M,7
^FO050,115^FH^FDQA,<t t-esc="grn.name" />^FS
</t>
<t t-name="grn_name">
^FO050,290^FD<t t-esc="grn.name" />^FS
</t>
^XZ
          </t>
        </t>
    </template>


  <record model="ir.actions.report" id="report_stock_grn_label">
    <field name="name">GRN Label (ZPL)</field>
    <field name="model">stock.grn</field>
    <field name="report_type">qweb-text</field>
    <field name="report_name">stock_grn.label_stock_grn</field>
    <field name="report_file">stock_grn.label_stock_grn</field>
    <field name="binding_model_id" ref="model_stock_grn" />
    <field name="binding_type">report</field>
  </record>
</odoo>
