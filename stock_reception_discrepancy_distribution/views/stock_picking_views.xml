<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']/list/field[@name='quantity']"
                position="after"
            >
                <button
                    name="action_change_move_dest_qty"
                    type="object"
                    title="Change qty on dest moves"
                    icon="fa-code-fork"
                    invisible="state in ['done', 'cancel'] or picking_code != 'incoming' or origin_returned_move_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
