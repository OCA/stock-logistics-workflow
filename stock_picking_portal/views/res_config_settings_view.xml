<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.stock_picking_portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse_setting_container']" position="after">
                <block title="Portal" name="stock_picking_portal_setting_container">
                    <setting
                        id="stock_picking_portal_visible_operations"
                        string="Portal Operations"
                        help="Select which stock operation types should be visible to portal users."
                    >
                        <field
                            name="portal_visible_operation_ids"
                            widget="many2many_tags"
                            placeholder="Select operation types..."
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
