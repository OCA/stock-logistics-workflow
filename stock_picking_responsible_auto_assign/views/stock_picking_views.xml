<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.responsible.auto.assign</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="next_picking_id" invisible="1" />
                <field
                    name="next_picking_user_id"
                    widget="many2one_avatar_user"
                    invisible="not next_picking_id"
                    readonly="state in ('done', 'cancel')"
                />
                <field name="picking_progress" invisible="state != 'assigned'" />
            </field>
        </field>
    </record>
    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.list.responsible.auto.assign</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field
                    name="next_picking_user_id"
                    optional="hide"
                    widget="many2one_avatar_user"
                />
                <field name="picking_progress" optional="hide" />
                <field
                    name="is_in_progress"
                    optional="hide"
                    widget="boolean_toggle"
                    readonly="1"
                />
            </field>
        </field>
    </record>
    <record id="view_picking_internal_search" model="ir.ui.view">
        <field name="name">stock.picking.search.responsible.auto.assign</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <filter name="available" position="after">
                <filter
                    name="in_progress"
                    string="In Progress"
                    domain="[('is_in_progress', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
