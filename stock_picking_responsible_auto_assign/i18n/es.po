#: model:ir.model.fields,field_description:stock_picking_responsible_auto_assign.field_res_users__picking_assign_available
msgid "Available for Picking Assignment"
msgstr "Disponible para asignación de transferencias"

#. module: stock_picking_responsible_auto_assign
#: model:ir.model.fields,help:stock_picking_responsible_auto_assign.field_stock_picking_type__responsible_assign_same_user
msgid ""
"Copy the responsible of the previous transfer instead of balancing the "
"workload within the pool of this operation type."
msgstr ""
"Copia el responsable de la transferencia anterior en vez de balancear la "
"carga dentro del grupo de este tipo de operación."

