<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="portal_my_home_menu_move_operations"
        name="Portal layout: Stock Operations menu entry"
        inherit_id="portal.portal_breadcrumbs"
        priority="99"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'move_operations' or page_name == 'move_operation_line'"
                t-attf-class="breadcrumb-item #{'active ' if not move_operations else ''}"
            >
                <a
                    t-if="page_name == 'move_operation_line'"
                    t-attf-href="/my/move_operations?{{ keep_query() }}"
                >Move Operations</a>
                <t t-else="">Move Operations</t>
            </li>
        </xpath>
    </template>
    <template
        id="portal_my_home_move_operations"
        name="Show Move Operations"
        customize_show="True"
        inherit_id="portal.portal_my_home"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_category row g-2 mt-3" id="portal_stock_category">
                <t t-call="portal.portal_docs_entry">
                    <t
                        t-set="icon"
                        t-value="'/stock_move_line_portal/static/src/img/movements.svg'"
                    />
                    <t t-set="title">Move Operations</t>
                    <t t-set="url" t-value="'/my/move_operations'" />
                    <t t-set="text">Follow, view your operations</t>
                    <t t-set="placeholder_count" t-value="'move_operations_count'" />
                </t>
            </div>
        </xpath>
    </template>
    <template id="portal_my_move_operations" name="My Move Operations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Move Operations</t>
            </t>
            <t t-if="move_operation_ids" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>
                            <span class='d-none d-md-inline'>Document #</span>
                        </th>
                        <th class="text-center">Movement date</th>
                        <th class="text-center">Type</th>
                        <th class="text-center">Product</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">State</th>
                    </tr>
                </thead>
                <t t-foreach="move_operation_ids" t-as="move_line">
                    <tr>
                        <td>
                            <a
                                t-attf-href="{{ '/my/move_operations/%s?access_token=%s' % (move_line.id, move_line.access_token) }}"
                            >
                                <t t-out="move_line.reference" />
                            </a>
                        </td>
                        <td class="text-center">
                            <span
                                t-field="move_line.date"
                                t-options="{'widget': 'date'}"
                            />&amp;nbsp;
                            <span
                                class='d-none d-md-inline'
                                t-field="move_line.date"
                                t-options="{'time_only': True}"
                            />
                        </td>
                        <td class="text-center">
                            <span t-if="move_line.picking_code == 'incoming'">
                                Receipt
                            </span>
                            <span t-elif="move_line.picking_code == 'outgoing'">
                                Delivery
                            </span>
                            <span t-else="">
                                <t t-out="move_line.picking_type_id.name" />
                            </span>
                        </td>
                        <td class="text-center">
                            <t t-out="move_line.product_id.display_name" />
                        </td>
                        <td class="text-center">
                            <span t-field="move_line.quantity" />
                            <span t-field="move_line.product_uom_id" />
                        </td>
                        <td class="text-center">
                            <span
                                t-if="move_line.state == 'done'"
                                class="small badge text-bg-success orders_label_text_align"
                            >
                                <i class="fa fa-fw fa-truck" />
                                <b>Shipped</b>
                            </span>
                            <span
                                t-elif="move_line.state == 'cancel'"
                                class="small badge text-bg-danger orders_label_text_align"
                            >
                                <i class="fa fa-fw fa-times" />
                                <b>Cancelled</b>
                            </span>
                            <span
                                t-elif="move_line.state in ['draft', 'waiting', 'confirmed', 'assigned']"
                                class="small badge text-bg-info orders_label_text_align"
                            >
                                <i class="fa fa-fw fa-clock-o" />
                                <b>Preparation</b>
                            </span>
                        </td>
                    </tr>
                </t>
            </t>
            <p t-else="">There are currently no move operations for your account.</p>
        </t>
    </template>
    <template
        id="move_operation_portal_template"
        name="Move Operations Portal Template"
        inherit_id="portal.portal_sidebar"
        primary="True"
    >
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
                        <div class="row mt16 o_portal_sale_sidebar">
                                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'" />

                    <t t-set="title">
                    </t>
                </t>

                <div id="quote_content" class="col-12 col-lg justify-content-end">
                    <div class="o_portal_html_view shadow p-3">
                        <div class="o_portal_html_loader text-center">
                        </div>
                        <t t-call="stock_move_line_portal.move_operation_document">
                            <t t-set="o" t-value="move_operation" />
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <template id="move_operation_document">
        <t t-set="o" t-value="o.with_context(lang=o.picking_id._get_report_lang())" />
        <t t-set="address">
            <div name="div_outgoing_address">
                <div
                    name="outgoing_delivery_address"
                    t-if="o.picking_code == 'outgoing' and o.picking_partner_id"
                >
                    <span>
                        <strong>Delivery Address:</strong>
                    </span>
                    <div
                        t-field="o.picking_partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                    />
                    </div>
                <div
                    name="outgoing_warehouse_address"
                    t-elif="o.picking_code != 'internal' and o.picking_type_id.warehouse_id.partner_id"
                >
                    <span>
                        <strong>Warehouse Address:</strong>
                    </span>
                    <div
                        t-field="o.picking_type_id.warehouse_id.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                    />
                        </div>
            </div>
        </t>
        <t t-set="information_block">
            <div class="row">
                <div class="col-7" name="div_incoming_address">
                    <t t-set="show_partner" t-value="False" />
                    <div
                        name="vendor_address"
                        t-if="o.picking_code=='incoming' and o.picking_partner_id"
                    >
                        <span>
                            <strong>Vendor Address:</strong>
                        </span>
                        <t t-set="show_partner" t-value="True" />
                    </div>
                    <div
                        name="customer_address"
                        t-if="o.picking_code=='outgoing' and o.picking_partner_id and o.picking_partner_id != o.picking_partner_id.commercial_partner_id"
                    >
                        <span>
                            <strong>Customer Address:</strong>
                        </span>
                        <t t-set="show_partner" t-value="True" />
                    </div>
                    <div t-if="show_partner" name="partner_header">
                        <div
                            t-field="o.picking_partner_id.commercial_partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'
                        />
                    </div>
                </div>
            </div>
        </t>
        <div class="page">
            <h2>
                <span t-field="o.reference" />
            </h2>
            <div class="row mt32 mb32">
                <div t-if="o.origin" class="col-auto" name="div_origin">
                    <strong>Order:</strong>
                    <p t-field="o.origin" />
                </div>
                <div t-if="o.date" class="col-auto" name="div_move_date">
                    <strong>Movement Date:</strong>
                    <p t-field="o.date" />
                </div>
            </div>
            <table class="table table-sm" name="stock_move_line_detail">
                <thead>
                    <tr>
                        <th name="th_sml_product">
                            <strong>Product</strong>
                        </th>
                        <th
                            t-if="o.lot_id"
                            name="th_sml_lot"
                            groups="stock.group_lot_on_delivery_slip"
                        >
                            <strong>Lot/Serial Number</strong>
                        </th>
                        <th class="text-center" name="th_sml_from">
                            <strong>From</strong>
                        </th>
                        <th class="text-center" name="th_sml_to">
                            <strong>To</strong>
                        </th>
                        <th class="text-center" name="th_sml_quantity">
                            <strong>Quantity</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <span t-field="o.product_id" />
                        </td>
                        <td t-if="o.lot_id" groups="stock.group_lot_on_delivery_slip">
                            <span t-field="o.lot_id" />
                        </td>
                        <td class="text-center">
                            <span t-field="o.location_id" />
                        </td>
                        <td class="text-center">
                            <span t-field="o.location_dest_id" />
                        </td>
                        <td class="text-center">
                            <span t-field="o.quantity" />
                            <span t-field="o.product_uom_id" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>
