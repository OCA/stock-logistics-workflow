<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form - stock_picking_filter_lot</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids']/list/field[@name='lot_ids']"
                position="before"
            >
                <field name="location_usage" column_invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='move_ids']/list/field[@name='lot_ids']"
                position="attributes"
            >
                <attribute name="domain">
                    [('product_id', '=', product_id), ('location_ids', 'child_of', location_id)] if location_usage in ('internal', 'transit') else [('product_id', '=', product_id)]
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
