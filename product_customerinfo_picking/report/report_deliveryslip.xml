<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//span[@t-field='move.product_id']" position="attributes">
            <attribute
                name="t-if"
                add="not move.product_customer_code"
                separator="and"
            />
        </xpath>
        <xpath expr="//span[@t-field='move.product_id']" position="after">
            <span
                t-if="move.product_customer_code"
                t-out="move._get_report_product_display_name()"
            />
        </xpath>
        <xpath expr="//span[@t-field='bo_line.product_id']" position="attributes">
            <attribute
                name="t-if"
                add="not bo_line.product_customer_code"
                separator="and"
            />
        </xpath>
        <xpath expr="//span[@t-field='bo_line.product_id']" position="after">
            <span
                t-if="bo_line.product_customer_code"
                t-out="bo_line._get_report_product_display_name()"
            />
        </xpath>
    </template>
    <template
        id="stock_report_delivery_has_serial_move_line"
        inherit_id="stock.stock_report_delivery_has_serial_move_line"
    >
        <xpath expr="//span[@t-field='move_line.product_id']" position="attributes">
            <attribute
                name="t-if"
                add="not move_line.move_id.product_customer_code"
                separator="and"
            />
        </xpath>
        <xpath expr="//span[@t-field='move_line.product_id']" position="after">
            <span
                t-if="move_line.move_id.product_customer_code"
                t-out="move_line.move_id._get_report_product_display_name()"
            />
        </xpath>
    </template>
</odoo>
