<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app/block[@name='operations_setting_container']"
                position="after"
            >
                <block
                    title="Product Customerinfo Picking"
                    name="product_customerinfo_picking_setting_container"
                >
                    <setting id="customer_product_info_report">
                        <field name="display_customer_product_info_report" />
                        <div class="row mt-2">
                            <div class="text-muted">
                                Prints Customer Product Info on Picking Reports
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
