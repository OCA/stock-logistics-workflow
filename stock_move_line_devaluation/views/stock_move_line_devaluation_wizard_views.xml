<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_line_devaluation_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.line.devaluation.wizard.form</field>
        <field name="model">stock.move.line.devaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Withdrawal Valuation">
                <group>
                    <group string="Customer">
                        <field name="partner_id" />
                        <field name="pricelist_id" />
                    </group>
                    <group string="Period">
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_generate_report"
                        type="object"
                        string="Generate Report"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_stock_move_line_devaluation_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Stock Withdrawal Valuation</field>
        <field name="res_model">stock.move.line.devaluation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_stock_move_line_devaluation"
        name="Withdrawal Valuation"
        parent="stock.menu_warehouse_report"
        action="action_stock_move_line_devaluation_wizard"
        sequence="100"
    />
</odoo>
