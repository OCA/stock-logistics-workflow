<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- stock picking form view inherit. -->
    <record id="view_picking_form_inherited_smartbutton" model="ir.ui.view">
        <field name="name">stock.picking.form.smartbutton.related</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                    <button
                    name="action_view_related_pickings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="related_picking_count == 0"
                >
                    <field
                        name="related_picking_count"
                        string="Related Pickings"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
