<odoo>
    <record id="stock_move_valuation_usage_form" model="ir.ui.view">
        <field name="name">stock.move.valuation.usage.form</field>
        <field name="model">stock.move.valuation.usage</field>
        <field name="arch" type="xml">
            <form edit="0" create="0">
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="quantity" />
                        <field name="value" />
                        <field name="src_stock_move_id" />
                        <field name="dest_stock_move_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="stock_move_valuation_usage_list" model="ir.ui.view">
        <field name="name">stock.move.valuation.usage.list</field>
        <field name="model">stock.move.valuation.usage</field>
        <field name="arch" type="xml">
            <list edit="0" create="0">
                <field name="product_id" />
                <field name="quantity" sum="Quantity" />
                <field name="value" sum="Value" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="stock_move_valuation_usage_search" model="ir.ui.view">
        <field name="name">stock.move.valuation.usage.search</field>
        <field name="model">stock.move.valuation.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
                <field name="quantity" />
                <field name="value" />
                <field name="company_id" groups="base.group_multi_company" />
            </search>
        </field>
    </record>
    <record id="stock_move_valuation_usage_pivot" model="ir.ui.view">
        <field name="name">stock.move.valuation.usage.pivot</field>
        <field name="model">stock.move.valuation.usage</field>
        <field name="arch" type="xml">
            <pivot string="Stock Move Valuation Usage Analysis">
                <field name="product_id" type="row" />
                <field name="quantity" type="measure" />
                <field name="value" type="measure" />
            </pivot>
        </field>
    </record>
    <record id="stock_move_valuation_usage_action" model="ir.actions.act_window">
        <field name="name">Stock Move Valuation Usages</field>
        <field name="res_model">stock.move.valuation.usage</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="stock_move_valuation_usage_list" />
        <field name="search_view_id" ref="stock_move_valuation_usage_search" />
    </record>
    <menuitem
        action="stock_move_valuation_usage_action"
        id="stock_move_valuation_usage_menu"
        parent="stock.menu_warehouse_report"
        groups="base.group_no_one"
    />
</odoo>
